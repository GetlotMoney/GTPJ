++        if identity["pgid"] != helper_process.pid or identity["sid"] != helper_process.pid:
++            raise RuntimeError("helper 没有建立预期的独立进程组与会话。")
++        identity["pidfd"] = pidfd
++        return identity
++    except BaseException:
++        if pidfd is not None:
