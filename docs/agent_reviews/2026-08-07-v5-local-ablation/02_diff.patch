++        ).stdout.strip()
++        if resolved != expected_commit:
++            raise ValueError("Git bundle 无法解析准确的 pre_run_freeze_commit。")
++        run_checked(
++            ["git", "cat-file", "-e", f"{TEMPLATE_COMMIT}^{{commit}}"],
