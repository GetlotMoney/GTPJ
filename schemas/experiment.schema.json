{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.gtpj/schemas/experiment.schema.json",
  "title": "GTPJ formal experiment code binding",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "framework_id",
    "kind",
    "base_identity_kind",
    "base_template_id",
    "base_template_tag",
    "base_template_commit",
    "template_registry_commit",
    "historical_code_ref",
    "template_binding_status",
    "experiment_branch",
    "legacy_ref",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "gtpj.experiment.v1"},
    "experiment_id": {"pattern": "^V[0-9]+-(TUNE|ABLATION|INNOVATION|CONFIRM)-[0-9]{3}$"},
    "framework_id": {"pattern": "^FRAMEWORK-V[0-9]+$"},
    "kind": {"enum": ["tune", "ablation", "innovation", "confirmation"]},
    "base_identity_kind": {"enum": ["framework_template", "historical_code_ref", "pending_clean_template"]},
    "base_template_id": {"pattern": "^(none|FRAMEWORK-V[0-9]+|MODEL-V[0-9]+-TEMPLATE-V[0-9]+)$"},
    "base_template_tag": {"type": "string"},
    "base_template_commit": {"pattern": "^(none|[0-9a-f]{40})$"},
    "template_registry_commit": {"pattern": "^(none|[0-9a-f]{40})$"},
    "historical_code_ref": {"type": "string"},
    "template_binding_status": {"enum": ["ready", "historical_read_only", "blocked_pending_clean_template"]},
    "experiment_branch": {"type": "string"},
    "candidate_family": {"pattern": "^(none|[a-z0-9]+([-_][a-z0-9]+)*)$"},
    "target_framework": {"pattern": "^(none|FRAMEWORK-V[0-9]+)$"},
    "candidate_framework_status": {"enum": ["not_applicable", "attempt_only"]},
    "legacy_ref": {"type": "string"},
    "status": {"type": "string"}
  },
  "additionalProperties": true
}
